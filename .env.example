# Пароль для входа в панель (обязательно)
ADMIN_PASSWORD=change-me
# Токен для API (iOS-приложение, скрипты): заголовок Authorization: Bearer <token>. Пусто = выключено
API_TOKEN=
# Путь, по которому панель доступна на домене
BASE_PATH=/browser
PORT=3100
# Максимум одновременно открытых браузеров (каждый ~200-400 МБ RAM)
MAX_SESSIONS=3
# Размер окна браузера: координаты в сценариях считаются в этой системе
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
# Ставь 1, если панель открывается по https (cookie будет Secure)
COOKIE_SECURE=1
